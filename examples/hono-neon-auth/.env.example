# Required — the base URL of your Neon Auth instance.
NEON_AUTH_BASE_URL=https://auth.your-neon-project.example.com

# Required — cookie signing secret. Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
NEON_AUTH_COOKIE_SECRET=change-me-please-at-least-32-characters

# Optional — the port to bind the Hono server to (default 3000).
PORT=3000
